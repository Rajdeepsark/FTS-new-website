---
/**
 * Fixed bottom navigation — layer 2 ("navigation") of the Figma hero frame, finished
 * in glass after Apple's Liquid Glass.
 *
 *   navigation  row · gap 6px · 32px from the bottom edge (20px on phones)
 *   links       glass capsule · padding 16px 26px · radius 120px
 *               Inter 400 · 13/14 · uppercase · 5 × 5 dot after each link but the last
 *   Talk to us  prominent glass capsule: white-tinted, #000 label · padding 16px 32px
 *   phones      one line, as the client asked: tighter capsules (padding 12px and
 *               18px, links 6px apart), and below 392px wide the type, padding and
 *               gaps shrink together to keep it on one line, down to 11px type
 *               (about 335px wide); narrower screens wrap the button under the links
 *
 * Where they go: Projects and Services scroll to those homepage sections (from any
 * other page they open the homepage there), About is its own page, and Talk to us
 * scrolls down to the footer (`#contact`), which is on every page; there is no
 * separate contact page. Lenis (see `SiteLayout`) makes the in-page scrolls smooth.
 *
 * The glass, as one `.glass` class on the finished shapes (never glass on glass):
 *   material    the browser's own `backdrop-filter`: a blur, then a brightness
 *               squeeze that keeps the lettering legible on any backdrop (see
 *               "Tones" in the style block), then the colour put back. On top, a
 *               1px specular rim, brightest top-left and bottom-right, and an
 *               inner glow
 *   refraction  Chromium only, switched on by the script, for the links capsule
 *               in the light tone: the SVG lens from `scripts/glassLens.ts`
 *               replaces the blur. It frosts the middle the same way and bends
 *               a clearer, brighter copy of the backdrop inward along a 13px
 *               bezel
 *   lozenge     a highlight that glides between the links under the pointer or
 *               keyboard focus and rests on the current page's link
 *   touch       only the things you can press respond: links and the button dip
 *               when pressed, the button lifts on hover
 *   fallback    without `backdrop-filter`, or when the visitor asks for less
 *               transparency or more contrast, the capsules turn solid
 *
 * Tone: the nav watches any `[data-nav-tone]` element and takes that tone while the
 * element sits in the band the nav occupies. "light" is white lettering on clear
 * glass, for photos and dark sections; everywhere else it falls back to "dark":
 * ink lettering on milky glass. Without JS it stays in the fallback tone.
 */
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/#work", label: "Projects", dot: true },
  { href: "/#services", label: "Services", dot: true },
  { href: "/about", label: "About", dot: false },
];
---

<nav
  class="pointer-events-none fixed inset-x-0 bottom-5 z-50 flex flex-wrap items-stretch justify-center gap-1.5 px-3 sm:bottom-8 sm:px-4"
  aria-label="Main navigation"
  data-floating-nav
  data-tone="dark"
>
  <ul class="links glass pointer-events-auto flex items-center py-4" data-nav-links>
    <li class="lozenge" aria-hidden="true" data-nav-lozenge></li>
    {links.map(({ href, label, dot }) => (
      <li class="flex items-center">
        <a
          class="link relative block whitespace-nowrap rounded-full py-[5px] font-normal uppercase leading-[14px]"
          href={href}
          aria-current={currentPath === href ? "page" : undefined}
        >
          <span class="relative inline-block">
            {label}
            {dot && <span class="dot absolute top-0 size-[5px] rounded-full bg-current" aria-hidden="true" />}
          </span>
        </a>
      </li>
    ))}
  </ul>

  <a
    class="glass glass-prominent pointer-events-auto flex items-center justify-center self-stretch whitespace-nowrap py-4 font-normal uppercase leading-[14px]"
    href="#contact"
  >
    Talk to us
  </a>
</nav>

<style>
  /* ---- Tones ------------------------------------------------------------------ */
  /* Legibility is settled here, for any backdrop, not left to the photo behind.
     Light tone: contrast(0.5) brightness(0.48) squeezes the backdrop into 12%–36%
     brightness before the white lettering goes on, and saturate(200%) gives the
     colour back without lifting it. Dark tone: a 60% white tint does the same for
     the ink lettering. Measured in Chrome with the page grain on, worst pixel
     under a label: 5.3:1 over flat white and 4.7:1 with the lozenge on top (the
     worst cases), about 7:1 over the hero clip, 5.6:1 for ink over flat black. */
  nav {
    --glass-ink: #16251f;
    --glass-tint: rgb(255 255 255 / 0.6);
    --glass-optics: contrast(1) brightness(1.06) saturate(170%);
    --glass-rim: rgb(255 255 255 / 0.95);
    --glass-rim-soft: rgb(255 255 255 / 0.3);
    --glass-depth: 0 12px 36px -12px rgb(0 0 0 / 0.32), 0 1px 3px rgb(0 0 0 / 0.08);
    --glass-glow: inset 0 1px 0 rgb(255 255 255 / 0.7), inset 0 -8px 12px -8px rgb(22 37 31 / 0.1);
    --glass-solid: #f7f8f4;
    --lozenge: rgb(22 37 31 / 0.08);
  }

  nav[data-tone="light"] {
    --glass-ink: #fff;
    --glass-tint: rgb(255 255 255 / 0);
    --glass-optics: contrast(0.5) brightness(0.48) saturate(200%);
    --glass-rim: rgb(255 255 255 / 0.6);
    --glass-rim-soft: rgb(255 255 255 / 0.08);
    --glass-depth: 0 12px 32px -12px rgb(0 0 0 / 0.5);
    --glass-glow: inset 0 1px 0 rgb(255 255 255 / 0.2), inset 0 0 14px rgb(255 255 255 / 0.07);
    --glass-solid: #262523;
    --lozenge: rgb(255 255 255 / 0.06);
  }

  /* ---- Size ------------------------------------------------------------------- */
  /* --u is one design pixel: 1px, except on phones narrower than the compact row
     (366px plus the 12px margins and a little slack), where it shrinks so the row
     still fits, stopping at 11px type. */
  nav {
    --u: 1px;
    font-size: calc(13 * var(--u));
  }

  .links {
    gap: calc(6 * var(--u));
    padding-inline: calc(12 * var(--u));
  }

  .link {
    padding-inline: calc(6 * var(--u));
  }

  .dot {
    right: calc(-10 * var(--u));
  }

  .glass-prominent {
    padding-inline: calc(18 * var(--u));
  }

  @media (width < 40rem) {
    nav {
      --u: max(11px / 13, min(1px, (100vw - 24px) / 368));
    }
  }

  @media (width >= 40rem) {
    .links {
      gap: 20px;
      padding-inline: 26px;
    }

    .glass-prominent {
      padding-inline: 32px;
    }
  }

  /* ---- Material ---------------------------------------------------------------- */
  .glass {
    position: relative;
    isolation: isolate;
    border-radius: 120px;
    background-color: var(--glass-tint);
    -webkit-backdrop-filter: blur(16px) var(--glass-optics);
    backdrop-filter: blur(16px) var(--glass-optics);
    box-shadow: var(--glass-depth), var(--glass-glow);
    color: var(--glass-ink);
  }

  /* Tone changes cross-fade, but only once the script has set the first tone: the
     markup starts in the fallback tone, and the page should not open on a fade. */
  nav[data-ready] .glass {
    transition:
      background-color 0.3s ease,
      -webkit-backdrop-filter 0.3s ease,
      backdrop-filter 0.3s ease,
      box-shadow 0.3s ease,
      color 0.3s ease;
  }

  /* Specular rim: a 1px ring, lit from the top left and catching light again at the
     bottom right. The mask keeps only the ring of the gradient. */
  .glass::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      140deg,
      var(--glass-rim) 0%,
      var(--glass-rim-soft) 30%,
      var(--glass-rim-soft) 66%,
      var(--glass-rim) 100%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  /* Refraction, for the links capsule in the light tone (the dark tone only ever sits
     on flat paper, where there is nothing to bend). The lens filter frosts and
     grades the backdrop itself, so it replaces the whole list above. */
  nav[data-tone="light"] .glass[data-refract] {
    -webkit-backdrop-filter: var(--glass-lens);
    backdrop-filter: var(--glass-lens);
  }

  /* The button: glass tinted almost to white, in either tone. */
  .glass-prominent {
    --glass-ink: #000;
    --glass-tint: rgb(255 255 255 / 0.86);
    --glass-optics: contrast(1) brightness(1) saturate(170%);
    --glass-rim: #fff;
    --glass-rim-soft: rgb(255 255 255 / 0.5);
    --glass-glow: inset 0 1px 0 #fff, inset 0 -8px 12px -8px rgb(0 0 0 / 0.1);
    --glass-solid: #fff;
  }

  /* ---- Touch: only what can be pressed responds --------------------------------- */
  nav .glass.glass-prominent {
    transition:
      background-color 0.3s ease,
      transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  @media (hover: hover) {
    .glass-prominent:hover {
      --glass-tint: #fff;
      transform: scale(1.03);
    }
  }

  .glass-prominent:active {
    transform: scale(0.96);
  }

  .link {
    transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .link:active {
    transform: scale(0.94);
  }

  .link:focus-visible,
  .glass-prominent:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* The lozenge sits 8px inside the capsule, so the two curves stay concentric. The
     script places it with --lozenge-x / --lozenge-width and shows it by setting
     data-lozenge on the nav. */
  .lozenge {
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    z-index: -1;
    width: var(--lozenge-width, 0px);
    border-radius: 120px;
    background-color: var(--lozenge);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.16),
      inset 0 1px 0 rgb(255 255 255 / 0.3);
    opacity: 0;
    transform: translateX(var(--lozenge-x, 0px));
    transition:
      transform 0.5s cubic-bezier(0.3, 1.35, 0.45, 1),
      width 0.5s cubic-bezier(0.3, 1.35, 0.45, 1),
      opacity 0.25s ease,
      background-color 0.3s ease;
    pointer-events: none;
  }

  nav[data-lozenge] .lozenge {
    opacity: 1;
  }

  /* ---- Fallback: no backdrop-filter, or the visitor asked for a plainer screen -- */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass {
      background-color: var(--glass-solid);
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .glass,
    nav[data-tone="light"] .glass[data-refract] {
      background-color: var(--glass-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav[data-ready] .glass,
    nav .glass.glass-prominent,
    .link,
    .lozenge {
      transition: none;
    }

    .glass-prominent:hover,
    .glass-prominent:active,
    .link:active {
      transform: none;
    }
  }
</style>

<script>
  import { refract } from "../scripts/glassLens";

  const nav = document.querySelector<HTMLElement>("[data-floating-nav]");
  const list = nav?.querySelector<HTMLElement>("[data-nav-links]");
  const lozenge = list?.querySelector<HTMLElement>("[data-nav-lozenge]");

  // ---- Tone -------------------------------------------------------------------
  const zones = document.querySelectorAll<HTMLElement>("[data-nav-tone]");

  if (nav && zones.length && "IntersectionObserver" in window) {
    const active = new Set<HTMLElement>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const zone = entry.target as HTMLElement;
          if (entry.isIntersecting) active.add(zone);
          else active.delete(zone);
        }
        const [zone] = active;
        nav.dataset.tone = zone?.dataset.navTone ?? "dark";
        // From the next frame on, tone changes cross-fade (see the style block).
        if (!nav.hasAttribute("data-ready")) requestAnimationFrame(() => nav.setAttribute("data-ready", ""));
      },
      // Only the bottom ~14% of the viewport — the band the nav sits in — counts.
      { rootMargin: "-86% 0px 0px 0px", threshold: 0 },
    );
    zones.forEach((zone) => observer.observe(zone));
  }

  // ---- Lozenge ----------------------------------------------------------------
  if (nav && list && lozenge) {
    const links = list.querySelectorAll<HTMLElement>("a");
    const home = list.querySelector<HTMLElement>('a[aria-current="page"]');
    const wide = window.matchMedia("(width >= 40rem)");
    let target: HTMLElement | null = null;

    // Px the lozenge extends past a link's label on each side: 18 design pixels,
    // 7 in the compact phone row, where 18 would cover the dot before it.
    const reach = () => (wide.matches ? 18 : 7) * (parseFloat(getComputedStyle(nav).fontSize) / 13);

    const place = (link: HTMLElement | null) => {
      target = link;
      if (!link) return nav.removeAttribute("data-lozenge");

      const label = link.firstElementChild as HTMLElement;
      const x = link.offsetLeft + label.offsetLeft - reach();
      const appearing = !nav.hasAttribute("data-lozenge");
      // Coming out of hiding it fades in where it is needed; it only glides
      // between links.
      if (appearing) lozenge.style.transition = "none";
      lozenge.style.setProperty("--lozenge-x", `${x.toFixed(1)}px`);
      lozenge.style.setProperty("--lozenge-width", `${(label.offsetWidth + reach() * 2).toFixed(1)}px`);
      if (appearing) {
        void lozenge.offsetWidth;
        lozenge.style.removeProperty("transition");
      }
      nav.setAttribute("data-lozenge", "");
    };

    for (const link of links) {
      link.addEventListener("pointerenter", () => place(link));
      link.addEventListener("focus", () => place(link));
    }
    list.addEventListener("pointerleave", () => place(home));
    list.addEventListener("focusout", (event) => {
      if (!list.contains(event.relatedTarget as Node | null)) place(home);
    });

    // The links move when the fonts arrive or the row wraps.
    new ResizeObserver(() => place(target)).observe(list);
    place(home);
  }

  // ---- Refraction ---------------------------------------------------------------
  // The links capsule gets a lens; the style block uses it in the light tone only.
  if (list) refract(list);
</script>
