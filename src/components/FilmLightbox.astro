---
/**
 * The Films page's video lightbox: one <dialog> that plays whichever film's
 * still was pressed (`FilmStill` marks the stills with `data-film-play`, the
 * YouTube id, and `data-film-title`). The video is embedded from
 * youtube-nocookie.com and starts on open; closing empties the frame, so
 * playback stops.
 *
 *   frame     92vw, up to 1100px, and never taller than 84svh · 16:9 · #000
 *   backdrop  black at 80%, blurred
 *   close     a 40px glass button above the frame's top-right corner
 *   closes    Escape, the close button, or a press on the backdrop
 *
 * While it is open the page behind cannot scroll: `html` gets `overflow: hidden`
 * and `data-lenis-prevent` keeps Lenis (see `SiteLayout`) from taking the wheel
 * over the dialog. On close the browser returns focus to the pressed still.
 * Plain clicks open the lightbox; modified ones (a new tab, a new window) go to
 * YouTube as the links say. Without JS the dialog never opens and the stills
 * link to YouTube.
 */
---

<dialog
  class="lightbox m-auto w-[min(92vw,1100px,150svh)] max-w-none overflow-visible border-0 bg-transparent p-0 text-cream backdrop:bg-black/80 backdrop:backdrop-blur-sm"
  aria-labelledby="film-lightbox-title"
  data-film-lightbox
  data-lenis-prevent
>
  <div class="relative">
    <p id="film-lightbox-title" class="sr-only" data-film-lightbox-title>Film</p>

    <button
      type="button"
      class="absolute bottom-full right-0 mb-3 inline-flex size-10 items-center justify-center rounded-full border border-white/20 bg-white/10 text-cream backdrop-blur-md transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      aria-label="Close"
      data-film-lightbox-close
    >
      <svg
        class="size-4"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 3l10 10M13 3L3 13"></path>
      </svg>
    </button>

    <div class="aspect-video w-full bg-black shadow-[0_24px_80px_-24px_rgb(0_0_0/0.9)]">
      <iframe
        class="size-full border-0"
        title="Film"
        allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        data-film-lightbox-player></iframe>
    </div>
  </div>
</dialog>

<style is:global>
  html.lightbox-open {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-film-lightbox]");
  const player = dialog?.querySelector<HTMLIFrameElement>("[data-film-lightbox-player]");
  const heading = dialog?.querySelector<HTMLElement>("[data-film-lightbox-title]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-film-lightbox-close]");

  if (dialog && player && typeof dialog.showModal === "function") {
    const open = (id: string, title: string) => {
      if (heading) heading.textContent = title;
      player.title = title;
      player.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1`;
      document.documentElement.classList.add("lightbox-open");
      dialog.showModal();
    };

    for (const trigger of document.querySelectorAll<HTMLElement>("[data-film-play]")) {
      trigger.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        open(trigger.dataset.filmPlay ?? "", trigger.dataset.filmTitle ?? "Film");
      });
    }

    closeButton?.addEventListener("click", () => dialog.close());

    // A press on the backdrop lands on the dialog itself, not on its contents.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => {
      player.src = "about:blank";
      document.documentElement.classList.remove("lightbox-open");
    });
  }
</script>
