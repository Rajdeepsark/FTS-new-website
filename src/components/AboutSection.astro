---
/**
 * Third homepage section: "( We are ) A Creative Studio for meaningful Storytelling".
 *
 * Built from the 1440 × 905 design frame (a screenshot; no Figma CSS for this one):
 *   background  cream #F2EBE3 · #0D0C0B text
 *   statement   the centred 506px block, 108px from the top: a 90px label column
 *               beside a 416px text column. Label Inter 500 · 14/14 · uppercase,
 *               level with the first heading line; heading 48/120% · -0.03em with
 *               serif runs at the same size; body Inter 400 · 20/150% · -0.02em,
 *               32px under the heading. All left-aligned
 *   cards       three project cards scattered around the statement, each a picture
 *               with "( 01 )" (Inter 500 · 14/14 · uppercase · 50%) and the project
 *               title (Inter 400 · 14/130% · -0.03em) under it:
 *                 left    219 × 170 at (71, 381)
 *                 right   181 × 160 at (1259, 292), flush with the right edge
 *                 bottom  410 × 220 at (839, 601)
 *               Below `lg` they drop into a loose two-column grid under the text.
 *
 * Scroll drift (skipped under prefers-reduced-motion and without JS): while the
 * section crosses the screen, each card slides a few dozen pixels along its own
 * x/y path (`from` → `to` below), so the three seem to float at different depths.
 * A card is at `from` when the section's top enters at the bottom of the screen and
 * at `to` when its bottom leaves at the top, and it trails the scroll slightly so it
 * glides. The right card only moves further off its edge, never away from it, and
 * the bottom card only moves down, away from the text. Paths are halved below `lg`.
 *
 * Cards take their number, title and picture from `src/data/projects.ts` (the
 * project's `still` where it has one). The design repeats "( 01 ) The Scroll That
 * Stole Time" under all three as a placeholder.
 */
import { projects, type Project } from "../data/projects";

interface Pick {
  /** Project number in `src/data/projects.ts`. */
  number: string;
  aspect: string;
  /** Design position and width, `lg` and up. */
  place: string;
  /** Placement in the grid below `lg`. */
  grid: string;
  /** Extra classes for the caption. */
  caption?: string;
  /** Drift path in px, [x, y] at the start and at the end of the section's pass. */
  from: [number, number];
  to: [number, number];
}

const picks: Pick[] = [
  {
    number: "01",
    aspect: "aspect-[9/7]",
    place: "lg:left-[4.9%] lg:top-[381px] lg:w-[15.2%]",
    grid: "",
    from: [16, 36],
    to: [-16, -36],
  },
  {
    number: "04",
    aspect: "aspect-[9/8]",
    place: "lg:left-[87.4%] lg:top-[292px] lg:w-[12.6%]",
    grid: "mt-12",
    // Keeps the title clear of the edge the card drifts off.
    caption: "lg:pr-6",
    from: [0, 48],
    to: [24, -48],
  },
  {
    number: "06",
    aspect: "aspect-[15/8]",
    place: "lg:left-[58.3%] lg:top-[601px] lg:w-[28.5%]",
    grid: "col-span-2 w-3/4 justify-self-end",
    from: [-20, 0],
    to: [20, 32],
  },
];

const cards = picks.flatMap((pick) => {
  const project = projects.find((p: Project) => p.number === pick.number);
  const picture = project?.still ?? project?.image;
  return project && picture ? [{ ...pick, project, picture }] : [];
});
---

<section
  id="about"
  class="relative overflow-hidden bg-cream px-4 py-16 sm:px-8 lg:h-[905px] lg:px-0 lg:pb-0 lg:pt-[108px] 2xl:h-[62.8vw]"
  aria-labelledby="about-heading"
  data-about
>
  <div class="mx-auto grid max-w-[506px] gap-y-6 md:grid-cols-[90px_1fr]">
    <p class="pb-[5.71px] pt-[4.7px] text-[14px] font-medium uppercase leading-[14px] text-night md:mt-4 md:whitespace-nowrap">
      ( We are )
    </p>
    <h2 id="about-heading" class="text-[36px] font-normal leading-[120%] tracking-[-0.03em] text-night sm:text-[48px]">
      <span class="font-serif">A Creative Studio</span><br />
      for meaningful<br />
      <span class="font-serif">Storytelling</span>
    </h2>
    <div class="space-y-7 text-[17px] leading-[150%] tracking-[-0.02em] text-night sm:text-[20px] md:col-start-2 md:mt-2">
      <p>
        Flying Turtle Studio is a creative production house built on the belief that the most memorable
        stories come from thinking beyond the obvious.
      </p>
      <p>
        We blend artistry, storytelling, and technical expertise to craft meaningful visual experiences that
        leave a lasting impact—bringing imagination to life while staying true to what matters most.
      </p>
    </div>
  </div>

  <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 lg:contents">
    {
      cards.map(({ project, picture, aspect, place, grid, caption, from, to }) => (
        <figure
          class:list={["flex flex-col will-change-transform lg:absolute lg:m-0", grid, place]}
          data-drift={[...from, ...to].join(" ")}
        >
          <div class:list={["relative w-full overflow-hidden bg-[#e4ddd4]", aspect]}>
            <img
              class="absolute inset-0 size-full object-cover"
              src={picture.src}
              alt={picture.alt}
              width="820"
              height="560"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class:list={["mt-3", caption]}>
            <p class="text-[14px] font-medium uppercase leading-[14px] text-night/50">( {project.number} )</p>
            <p class="mt-1.5 text-[14px] leading-[130%] tracking-[-0.03em] text-night">{project.title}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-about]");
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
  const wide = window.matchMedia("(min-width: 64rem)");

  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-drift]"), (el) => {
      const [x0, y0, x1, y1] = (el.dataset.drift ?? "").split(" ").map(Number);
      return { el, x0, y0, x1, y1 };
    });
    // Seconds the cards take to close about two thirds of the gap to where the
    // scroll puts them, so a fast flick glides instead of jumping.
    const LAG = 0.25;

    // How far the section is through its pass, as shown (null until first placed).
    let shown: number | null = null;
    let running = false;
    let last = 0;

    const tick = (now: number) => {
      if (!motion.matches) {
        cards.forEach(({ el }) => el.style.removeProperty("transform"));
        shown = null;
        running = false;
        last = 0;
        return;
      }

      const elapsed = last ? Math.min(now - last, 100) : 1000 / 60;
      const pull = 1 - Math.exp(-elapsed / 1000 / LAG);
      last = now;

      // 0 as the section's top enters at the bottom, 1 as its bottom leaves at the top.
      const box = section.getBoundingClientRect();
      const goal = Math.min(1, Math.max(0, (window.innerHeight - box.top) / (window.innerHeight + box.height)));
      const from = shown ?? goal; // the first placement lands straight on the goal
      const t = Math.abs(goal - from) < 0.0005 ? goal : from + (goal - from) * pull;
      shown = t;

      const reach = wide.matches ? 1 : 0.5;
      for (const { el, x0, y0, x1, y1 } of cards) {
        const x = (x0 + (x1 - x0) * t) * reach;
        const y = (y0 + (y1 - y0) * t) * reach;
        el.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px)`;
      }

      if (t === goal) {
        running = false;
        last = 0;
      } else {
        requestAnimationFrame(tick);
      }
    };

    const schedule = () => {
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    motion.addEventListener("change", schedule);
    wide.addEventListener("change", schedule);
    running = true;
    tick(performance.now());
  }
</script>
