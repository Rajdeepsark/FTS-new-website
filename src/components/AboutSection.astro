---
/**
 * Third homepage section: "( We are ) A Creative Studio for meaningful Storytelling".
 *
 * Built from the 1440 × 905 design frame (a screenshot; no Figma CSS for this one):
 *   background  cream #F2EBE3 · #0D0C0B text
 *   statement   the centred 506px block, 108px from the top: a 90px label column
 *               beside a 416px text column. Label Inter 500 · 14/14 · uppercase,
 *               level with the first heading line; heading 48/120% · -0.03em with
 *               serif runs at the same size; body Inter 400 · 20/150% · -0.02em,
 *               32px under the heading. All left-aligned
 *   cards       three of the studio's photos scattered around the statement (the
 *               design's own pictures), each with "( 01 )" (Inter 500 · 14/14 ·
 *               uppercase · 50%) and a caption (Inter 400 · 14/130% · -0.03em) under it:
 *                 left    219 × 170 at (71, 381)
 *                 right   181 × 160 at (1259, 292), flush with the right edge
 *                 bottom  410 × 220 at (839, 601)
 *               Below `lg` they drop into a loose two-column grid under the text.
 *
 * From `lg` up the section is one screen tall (100svh) and the frame is scaled to
 * fit inside it: `--u` is one design pixel, the smaller of a 1440th of the width and
 * a 905th of the height, and every size, gap and vertical position in the frame is a
 * multiple of it, so the statement and the cards never run into each other however
 * short the screen. A screen taller than the scaled frame centres it vertically.
 * Across the width the cards keep their place as a share of the screen (the right
 * one flush with its edge) and the statement stays centred.
 *
 * Scroll drift (skipped under prefers-reduced-motion and without JS): while the
 * section crosses the screen, each card slides a few dozen pixels along its own
 * x/y path (`from` → `to` below), so the three seem to float at different depths.
 * A card is at `from` when the section's top enters at the bottom of the screen and
 * at `to` when its bottom leaves at the top, and it trails the scroll slightly so it
 * glides. The right card only moves further off its edge, never away from it, and
 * the bottom card only moves down, away from the text. Paths are in design pixels,
 * so they scale with the frame from `lg` up; below it they are halved.
 *
 * The photos live in `public/about/`, cropped to their card shapes from the
 * 1100 × 701 originals in `public/services/` (photography.jpg, ad-films.jpg). The design
 * repeats "( 01 ) The Scroll That Stole Time" under all three as a placeholder; the
 * photos are not stills from a project, so each card is captioned with what it
 * shows instead.
 */
interface Card {
  number: string;
  caption: string;
  image: { src: string; alt: string; width: number; height: number };
  aspect: string;
  /** Horizontal place, `lg` and up. */
  place: string;
  /** Top and width in design pixels, `lg` and up. */
  top: number;
  width: number;
  /** Placement in the grid below `lg`. */
  grid: string;
  /** Extra classes for the caption. */
  captionClass?: string;
  /** Drift path in design px, [x, y] at the start and at the end of the section's pass. */
  from: [number, number];
  to: [number, number];
}

const cards: Card[] = [
  {
    number: "01",
    caption: "Sunset over the lake",
    image: { src: "/about/lake-sunset.jpg", alt: "The sun setting over a lake and hills", width: 901, height: 701 },
    aspect: "aspect-[9/7]",
    place: "lg:left-[4.9%]",
    top: 381,
    width: 219,
    grid: "",
    from: [16, 36],
    to: [-16, -36],
  },
  {
    number: "02",
    caption: "A festival after dark",
    image: {
      src: "/about/festival-night.jpg",
      alt: "A crowd on a hillside above a festival ground lit up at night",
      width: 789,
      height: 701,
    },
    aspect: "aspect-[9/8]",
    place: "lg:right-0",
    top: 292,
    width: 181,
    grid: "mt-12",
    // Keeps the caption clear of the edge the card drifts off.
    captionClass: "lg:pr-6",
    from: [0, 48],
    to: [24, -48],
  },
  {
    number: "03",
    caption: "Bare branches at dusk",
    image: {
      src: "/about/tree-branches.jpg",
      alt: "Bare tree branches against a blue evening sky",
      width: 1100,
      height: 587,
    },
    aspect: "aspect-[15/8]",
    place: "lg:left-[58.3%]",
    top: 601,
    width: 410,
    grid: "col-span-2 w-3/4 justify-self-end",
    from: [-20, 0],
    to: [20, 32],
  },
];
---

<section
  id="about"
  class="about relative overflow-hidden bg-cream px-4 py-16 sm:px-8"
  aria-labelledby="about-heading"
  data-about
>
  <div class="statement mx-auto grid max-w-[506px] gap-y-6 md:grid-cols-[90px_1fr]">
    <p class="label pb-[5.71px] pt-[4.7px] text-[14px] font-medium uppercase leading-[14px] text-night md:mt-4 md:whitespace-nowrap">
      ( We are )
    </p>
    <h2 id="about-heading" class="heading text-[36px] font-normal leading-[120%] tracking-[-0.03em] text-night sm:text-[48px]">
      <span class="font-serif">A Creative Studio</span><br />
      for meaningful<br />
      <span class="font-serif">Storytelling</span>
    </h2>
    <div class="body space-y-7 text-[17px] leading-[150%] tracking-[-0.02em] text-night sm:text-[20px] md:col-start-2 md:mt-2">
      <p>
        Flying Turtle Studio is a creative production house built on the belief that the most memorable
        stories come from thinking beyond the obvious.
      </p>
      <p>
        We blend artistry, storytelling, and technical expertise to craft meaningful visual experiences that
        leave a lasting impact—bringing imagination to life while staying true to what matters most.
      </p>
    </div>
  </div>

  <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 lg:contents">
    {
      cards.map(({ number, caption, image, aspect, place, top, width, grid, captionClass, from, to }) => (
        <figure
          class:list={["card flex flex-col will-change-transform", grid, place]}
          style={`--card-top: ${top}; --card-width: ${width}`}
          data-drift={[...from, ...to].join(" ")}
        >
          <div class:list={["relative w-full overflow-hidden bg-[#e4ddd4]", aspect]}>
            <img
              class="absolute inset-0 size-full object-cover"
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class:list={["mt-3", captionClass]}>
            <p class="card-number text-[14px] font-medium uppercase leading-[14px] text-night/50">( {number} )</p>
            <p class="card-title mt-1.5 text-[14px] leading-[130%] tracking-[-0.03em] text-night">{caption}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* One screen tall from `lg` up, with the design frame scaled to fit (see the top
     of the file). These rules sit outside Tailwind's layers, so they win over the
     utility classes in the markup, which size everything below `lg`. */
  @media (min-width: 64rem) {
    .about {
      --u: min(calc(100vw / 1440), calc(100svh / 905));
      --frame-top: calc((100svh - 905 * var(--u)) / 2);
      height: 100svh;
      padding: calc(var(--frame-top) + 108 * var(--u)) 0 0;
    }

    .statement {
      max-width: calc(506 * var(--u));
      grid-template-columns: calc(90 * var(--u)) 1fr;
      row-gap: calc(24 * var(--u));
    }

    .label {
      margin-top: calc(16 * var(--u));
      padding: calc(4.7 * var(--u)) 0 calc(5.71 * var(--u));
      font-size: calc(14 * var(--u));
      line-height: calc(14 * var(--u));
    }

    .heading {
      font-size: calc(48 * var(--u));
    }

    .body {
      margin-top: calc(8 * var(--u));
      font-size: calc(20 * var(--u));
    }

    .body > :not(:last-child) {
      margin-block-end: calc(28 * var(--u));
    }

    .card {
      position: absolute;
      margin: 0;
      top: calc(var(--frame-top) + var(--card-top) * var(--u));
      width: calc(var(--card-width) * var(--u));
    }

    .card figcaption {
      margin-top: calc(12 * var(--u));
    }

    .card-number {
      font-size: calc(14 * var(--u));
      line-height: calc(14 * var(--u));
    }

    .card-title {
      margin-top: calc(6 * var(--u));
      font-size: calc(14 * var(--u));
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-about]");
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
  const wide = window.matchMedia("(min-width: 64rem)");

  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-drift]"), (el) => {
      const [x0, y0, x1, y1] = (el.dataset.drift ?? "").split(" ").map(Number);
      return { el, x0, y0, x1, y1 };
    });
    // Seconds the cards take to close about two thirds of the gap to where the
    // scroll puts them, so a fast flick glides instead of jumping.
    const LAG = 0.25;

    // How far the section is through its pass, as shown (null until first placed).
    let shown: number | null = null;
    let running = false;
    let last = 0;

    const tick = (now: number) => {
      if (!motion.matches) {
        cards.forEach(({ el }) => el.style.removeProperty("transform"));
        shown = null;
        running = false;
        last = 0;
        return;
      }

      const elapsed = last ? Math.min(now - last, 100) : 1000 / 60;
      const pull = 1 - Math.exp(-elapsed / 1000 / LAG);
      last = now;

      // 0 as the section's top enters at the bottom, 1 as its bottom leaves at the top.
      const box = section.getBoundingClientRect();
      const goal = Math.min(1, Math.max(0, (window.innerHeight - box.top) / (window.innerHeight + box.height)));
      const from = shown ?? goal; // the first placement lands straight on the goal
      const t = Math.abs(goal - from) < 0.0005 ? goal : from + (goal - from) * pull;
      shown = t;

      // Paths are in design pixels: scaled with the frame from `lg` up, halved below.
      const reach = wide.matches ? Math.min(window.innerWidth / 1440, window.innerHeight / 905) : 0.5;
      for (const { el, x0, y0, x1, y1 } of cards) {
        const x = (x0 + (x1 - x0) * t) * reach;
        const y = (y0 + (y1 - y0) * t) * reach;
        el.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px)`;
      }

      if (t === goal) {
        running = false;
        last = 0;
      } else {
        requestAnimationFrame(tick);
      }
    };

    const schedule = () => {
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    motion.addEventListener("change", schedule);
    wide.addEventListener("change", schedule);
    running = true;
    tick(performance.now());
  }
</script>
