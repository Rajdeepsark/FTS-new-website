---
/**
 * Fourth homepage section: "( Our services )", a scroll-pinned list of services.
 *
 * Built from the 1440 × 801 design screenshot (no Figma CSS for this one):
 *   stage    full viewport, a photograph behind everything
 *   card     #181716 · inset 64px · padding 84px 56px 56px
 *   label    Inter 500 · 14/14 · uppercase · cream at 50%
 *   intro    Inter 400 · 18/150% · -0.02em · cream · 280px wide, 12px under the label
 *   list     Inter 500 · 32/44 · -0.07em (the width of Inter Tight) · cream. The
 *            service in focus is at full
 *            strength, held 12px clear of its neighbours and framed by four 6px
 *            viewfinder corners (13px beside the name, 8px above and below it);
 *            the names around it fade with distance: 33%, 15%, 8%, then nothing
 *   text     the focused service's description, Inter 400 · 18/150% · 273px wide
 *   picture  the focused service's image, 342 × 218 at the card's right edge
 *            Text and picture are centred on the focused name.
 *
 * Behaviour: the stage is pinned (`sticky top-0 h-svh`) while the page scrolls
 * through the track, and each service owns an equal 40svh share of that scroll.
 * Crossing into a share brings its service into focus: the list slides so the name
 * sits in the viewfinder, which takes the name's width, and the text and picture
 * cross-fade to match. The focused name always sits at the middle of the space
 * left under the intro; a mask fades the list out towards the edges of that space,
 * so shorter screens simply show fewer neighbours.
 *
 * Without JS nothing is pinned and the first service stays in focus. Under
 * prefers-reduced-motion the pin and the scroll steps remain but every change is
 * instant.
 *
 * Narrower screens: under 85rem (1360px) the picture sits above the text in one column
 * beside the list; on phones everything stacks (list, text, picture), the intro is
 * dropped for room, and the card keeps its bottom clear for the floating nav.
 *
 * Services, their descriptions and pictures live in `src/data/services.ts`; the
 * backdrop is `public/services/backdrop.jpg`.
 */
import { services } from "../data/services";

/** The service in focus before any scrolling (and for good without JS). */
const first = 0;
---

<section id="services" class="relative bg-night" aria-labelledby="services-heading" data-nav-tone="light">
  <div
    class="data-[scroll]:h-[calc(100svh+var(--travel))]"
    style={`--travel: ${services.length * 40}svh`}
    data-services-track
  >
    <div class="sticky top-0 h-svh overflow-hidden" data-services-stage>
      <img
        class="absolute inset-0 size-full object-cover"
        src="/services/backdrop.jpg"
        alt=""
        width="2200"
        height="1161"
        loading="lazy"
        decoding="async"
      />

      <div
        class="absolute inset-3 flex flex-col bg-[#181716] px-5 pb-[136px] pt-6 sm:inset-8 sm:p-10 lg:inset-16 lg:px-14 lg:pb-14 lg:pt-[clamp(40px,10.5svh,84px)]"
      >
        <h2
          id="services-heading"
          class="pb-[5.71px] pt-[4.7px] text-[14px] font-medium uppercase leading-[14px] text-cream/50"
        >
          ( Our services )
        </h2>
        <p class="mt-3 hidden max-w-[280px] text-[18px] leading-[150%] tracking-[-0.02em] text-cream md:block">
          We craft films, photography, and creative experiences that connect brands with people.
        </p>

        <div
          class="mt-6 flex min-h-0 flex-1 flex-col md:mt-8 md:grid md:grid-cols-[minmax(0,1fr)_38%] md:grid-rows-[1fr_auto_auto_1fr] md:gap-x-10 min-[85rem]:grid-cols-[44%_22.75%_minmax(0,1fr)] min-[85rem]:grid-rows-1 min-[85rem]:gap-x-0"
        >
          <div
            class="wheel relative -mx-5 h-[calc(5*var(--pitch)+1.5em)] shrink-0 overflow-hidden text-[clamp(17px,5.1vw,22px)] md:col-start-1 md:row-span-4 md:row-start-1 md:h-full md:text-[22px] lg:text-[28px] min-[85rem]:row-span-1 min-[85rem]:text-[clamp(28px,2.222vw,40px)]"
            style={`--active: ${first}`}
            data-services-wheel
          >
            <ul class="wheel-list">
              {
                services.map(({ name }, i) => (
                  <li
                    class="service"
                    data-near={Math.min(4, Math.abs(i - first))}
                    data-side={i < first ? "before" : i > first ? "after" : "on"}
                    aria-current={i === first ? "true" : undefined}
                    data-service
                  >
                    <span>{name}</span>
                  </li>
                ))
              }
            </ul>
            <span class="finder" aria-hidden="true" data-services-finder>
              <span class="invisible">{services[first].name}</span>
              <i></i><i></i><i></i><i></i>
            </span>
          </div>

          <div
            class="mt-4 grid shrink-0 text-[15px] leading-[150%] tracking-[-0.02em] text-cream md:col-start-2 md:row-start-3 md:mt-6 md:text-[16px] min-[85rem]:row-start-1 min-[85rem]:mt-0 min-[85rem]:self-center min-[85rem]:text-[clamp(16px,1.25vw,20px)]"
          >
            {
              services.map(({ description }, i) => (
                <p
                  class="col-start-1 row-start-1 opacity-0 transition-opacity duration-500 data-[current]:opacity-100 motion-reduce:transition-none"
                  data-current={i === first ? "" : undefined}
                  data-service-text
                >
                  {description}
                </p>
              ))
            }
          </div>

          <div
            class="relative mt-4 min-h-0 flex-1 overflow-hidden md:col-start-2 md:row-start-2 md:mt-0 md:aspect-[342/218] md:max-h-full md:flex-none min-[85rem]:col-start-3 min-[85rem]:row-start-1 min-[85rem]:ml-auto min-[85rem]:w-[85.7%] min-[85rem]:self-center"
          >
            {
              services.map(({ image }, i) => (
                <img
                  class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-700 data-[current]:opacity-100 motion-reduce:transition-none"
                  src={image.src}
                  alt={image.alt}
                  width="1100"
                  height="701"
                  loading="lazy"
                  decoding="async"
                  data-current={i === first ? "" : undefined}
                  data-service-image
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Everything in the list is sized in em, so it scales with the wheel's font size.
     --pitch is one row; --active (set inline, then by the script) is the row in focus. */
  .wheel {
    --pitch: 1.375em;
    --slide: 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: var(--pitch);
    white-space: nowrap;
    color: var(--color-cream, #f2ebe3);
    mask-image: linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
  }

  /* The focused row sits on the wheel's vertical centre. */
  .wheel-list {
    position: absolute;
    top: 50%;
    left: 1.25rem;
    transform: translateY(calc((var(--active) + 0.5) * -1 * var(--pitch)));
    transition: transform var(--slide);
  }

  .service {
    height: var(--pitch);
    opacity: 0;
    transition:
      opacity 0.4s ease,
      transform var(--slide);
  }

  .service[data-near="0"] {
    opacity: 1;
  }

  .service[data-near="1"] {
    opacity: 0.33;
  }

  .service[data-near="2"] {
    opacity: 0.15;
  }

  .service[data-near="3"] {
    opacity: 0.08;
  }

  /* The 12px (at 32px type) of air on either side of the focused row. */
  .service[data-side="before"] {
    transform: translateY(-0.375em);
  }

  .service[data-side="after"] {
    transform: translateY(0.375em);
  }

  /* Its width is the invisible name inside it until the script takes over. */
  .finder {
    position: absolute;
    top: 50%;
    left: calc(1.25rem - 0.42em);
    box-sizing: content-box;
    height: calc(var(--pitch) + 0.53em);
    padding-inline: 0.42em;
    transform: translateY(-50%);
    transition: width var(--slide);
    pointer-events: none;
  }

  .finder i {
    position: absolute;
    width: 6px;
    height: 6px;
    border: 0 solid currentColor;
  }

  .finder i:nth-of-type(1) {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }

  .finder i:nth-of-type(2) {
    top: 0;
    right: 0;
    border-width: 1px 1px 0 0;
  }

  .finder i:nth-of-type(3) {
    bottom: 0;
    left: 0;
    border-width: 0 0 1px 1px;
  }

  .finder i:nth-of-type(4) {
    right: 0;
    bottom: 0;
    border-width: 0 1px 1px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel-list,
    .service,
    .finder {
      transition: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-services-track]");
  const stage = track?.querySelector<HTMLElement>("[data-services-stage]");
  const wheel = track?.querySelector<HTMLElement>("[data-services-wheel]");
  const finder = track?.querySelector<HTMLElement>("[data-services-finder]");

  if (track && stage && wheel && finder) {
    const items = Array.from(track.querySelectorAll<HTMLElement>("[data-service]"));
    const texts = Array.from(track.querySelectorAll<HTMLElement>("[data-service-text]"));
    const images = Array.from(track.querySelectorAll<HTMLElement>("[data-service-image]"));
    let active = -1;
    let queued = false;

    // The viewfinder takes the width of the name it frames.
    const fit = () => {
      const name = items[active]?.firstElementChild as HTMLElement | null;
      if (name) finder.style.width = `${name.offsetWidth}px`;
    };

    const focus = (index: number) => {
      if (index === active) return;
      active = index;
      wheel.style.setProperty("--active", String(index));
      items.forEach((item, i) => {
        item.dataset.near = String(Math.min(4, Math.abs(i - index)));
        item.dataset.side = i < index ? "before" : i > index ? "after" : "on";
        if (i === index) item.setAttribute("aria-current", "true");
        else item.removeAttribute("aria-current");
      });
      for (const group of [texts, images]) {
        group.forEach((el, i) => el.toggleAttribute("data-current", i === index));
      }
      fit();
    };

    const render = () => {
      queued = false;
      // 0 when the stage starts to stick, 1 when the track lets it go.
      const travel = track.offsetHeight - stage.offsetHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, -track.getBoundingClientRect().top / travel)) : 0;
      focus(Math.min(items.length - 1, Math.floor(progress * items.length)));
    };

    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(render);
      }
    };

    track.toggleAttribute("data-scroll", true);

    // The names change width with the screen (their type scales) and when the web font arrives.
    new ResizeObserver(fit).observe(wheel);
    document.fonts?.ready.then(fit);

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    render();
  }
</script>
