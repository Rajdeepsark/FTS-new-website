---
/**
 * Brand logo: line-art sea turtle mark + "Flying Turtle Studio" wordmark.
 *
 * Artwork is picked up automatically from `public/`, in this order:
 *   1. `logo.svg` / `logo.png`            — the complete logo (mark + wordmark) as one image
 *   2. `logo-mark.svg` / `logo-mark.png`  — the turtle only, rendered beside the live wordmark text
 *   3. nothing on disk                    — an inline SVG turtle stand-in beside the wordmark
 *
 * `logo-mark.png` is currently an interim raster lifted from the design screenshot
 * (black on transparent, ~2x); replace it with the real vector mark when available.
 */
import fs from "node:fs";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const exists = (file: string) => fs.existsSync(new URL(`../../public/${file}`, import.meta.url));
const fullLogo = ["logo.svg", "logo.png"].find(exists);
const markOnly = ["logo-mark.svg", "logo-mark.png"].find(exists);
---

{
  fullLogo ? (
    <img
      src={`/${fullLogo}`}
      alt="Flying Turtle Studio"
      class:list={["h-9 w-auto sm:h-10", className]}
      width="440"
      height="92"
      decoding="async"
    />
  ) : (
    <span class:list={["inline-flex items-center gap-2.5", className]}>
      {markOnly ? (
        <img
          src={`/${markOnly}`}
          alt=""
          class="h-9 w-auto sm:h-10"
          width="89"
          height="91"
          decoding="async"
        />
      ) : (
        <svg
          class="h-9 w-auto sm:h-10"
          viewBox="0 0 100 96"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M64 34c4-12 14-22 26-28 2-1 3 1 2 3-7 9-13 18-17 30" />
          <path d="M30 50c-5-6-16-6-20 0-4 6 0 14 8 16 6 1 11-2 12-8" />
          <circle cx="14" cy="54" r="1.6" fill="currentColor" stroke="none" />
          <path d="M34 54c0-14 11-22 26-22s24 10 24 22-11 20-26 20-24-8-24-20Z" />
          <path d="M47 35c5 7 5 29 0 38M63 32v44M77 39c-5 7-5 23 0 30" />
          <path d="M76 64c8 4 14 12 16 24-7-5-12-12-17-20" />
          <path d="M46 72c-2 6-6 11-12 14 3-5 6-10 7-15" />
        </svg>
      )}
      <span class="text-[1.05rem] font-medium tracking-[-0.02em] sm:text-lg">Flying Turtle Studio</span>
    </span>
  )
}
