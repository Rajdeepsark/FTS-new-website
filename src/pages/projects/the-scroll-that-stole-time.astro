---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectSynopsis from "../../components/ProjectSynopsis.astro";
import ProjectChapters from "../../components/ProjectChapters.astro";
import { chapters } from "../../data/scrollThatStoleTime";
import { mailto } from "../../data/contact";

// The design's facts panel holds template text (a Berlin museum, a Norwegian
// award); these values come from the studio's own copy and the release poster.
const facts = [
  { label: "Typologies", lines: ["Short Film,", "Essay Film"] },
  { label: "Status", lines: ["Completed"] },
  { label: "Location", lines: ["Guwahati, Assam,", "India"] },
  { label: "Awards", lines: ["Best Essay Film,", "FICIMAD 2026"] },
];

// The synopsis ends on a request for a private screener: an email to Kaushik,
// filled in for the visitor to sign.
const screener = {
  label: "Request a private screener",
  href: mailto(
    "Private screener request - The Scroll That Stole Time",
    "Hi Kaushik, I’d like to request a private screener of The Scroll That Stole Time. - [your name]",
  ),
};
---

<SiteLayout
  title="The Scroll That Stole Time"
  description="A debut short film shot in Guwahati with zero budget, about how social media quietly steals our lives away."
  headerTone="light"
>
  <ProjectHero
    title="The Scroll That Stole Time"
    image={{
      // The release poster, the same image as the film's cards on the homepage
      // (`data/projects.ts`) and the Films page (`data/films.ts`).
      src: "/projects/the-scroll-that-stole-time.jpg",
      alt: "Poster for The Scroll That Stole Time: Phillips Neog lit by his phone, with the FICIMAD 2026 Best Essay Film and FICSAMAS 2025 Official Selection laurels",
      width: 1600,
      height: 900,
    }}
    facts={facts}
  />

  <ProjectSynopsis label="Synopsis" action={screener}>
    A debut short film shot entirely with zero budget, The Scroll that Stole Time explores the impact of technology on
    our lives through the story of Aarav, a man lost in the world of digital distractions. Set in Guwahati, Assam, this
    guerrilla-style project reflects on the isolating effects of social media addiction. With just a Panasonic Lumix
    S5iiX and a DJI Mini 4 Pro drone, the film was brought to life with improvisation, natural light, and a touch of
    Wong Kar-wai-inspired cinematography. This introspective film asks, “Are we controlling our phones, or are they
    controlling us?”
  </ProjectSynopsis>

  <ProjectChapters chapters={chapters} />
</SiteLayout>
