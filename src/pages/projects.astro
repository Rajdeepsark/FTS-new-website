---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Projects"
  description="Selected films and visuals by Flying Turtle Studio."
>
  <section class="mx-auto max-w-7xl px-6 pb-20 pt-40 sm:pt-48 lg:px-10">
    <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-ink/80">( Work )</p>
    <h1 class="mt-4 max-w-[12ch] text-5xl font-normal leading-[1.04] tracking-[-0.035em] sm:text-7xl">
      Selected <span class="font-serif text-[1.08em]">projects.</span>
    </h1>
    <p class="mt-8 max-w-xl text-lg leading-8 text-muted">Case studies coming soon.</p>
  </section>
</SiteLayout>
