---
/**
 * About page: a placeholder while the real page is written. It borrows the homepage
 * statement's type (label beside a left-aligned heading, body under it) and points
 * back to the homepage's "( We are )" section in the meantime.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About" description="About Flying Turtle Studio, a creative production house. This page is being written.">
  <section class="flex min-h-svh items-center bg-cream px-4 pb-32 pt-32 sm:px-8" aria-labelledby="about-page-heading">
    <div class="mx-auto grid w-full max-w-[506px] gap-y-6 md:grid-cols-[90px_1fr]">
      <p class="pb-[5.71px] pt-[4.7px] text-[14px] font-medium uppercase leading-[14px] text-night md:mt-4 md:whitespace-nowrap">
        ( About )
      </p>
      <h1 id="about-page-heading" class="text-[36px] font-normal leading-[120%] tracking-[-0.03em] text-night sm:text-[48px]">
        <span class="font-serif">Our story</span><br />
        is still being<br />
        <span class="font-serif">written</span>
      </h1>
      <div class="space-y-7 text-[17px] leading-[150%] tracking-[-0.02em] text-night sm:text-[20px] md:col-start-2 md:mt-2">
        <p>This page is on its way. Until it is ready, the homepage tells you who we are and what we make.</p>
        <p>
          <a class="underline decoration-1 underline-offset-4 transition-opacity hover:opacity-70" href="/#about">
            Read about the studio
          </a>
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
