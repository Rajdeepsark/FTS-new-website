---
/**
 * About page. The copy is the studio's own, from the About page of its live site
 * (flyingturtlestudio.in/about/), and so are the three photos (portrait, award
 * poster, motorcycle), saved into `public/about/`. There is no Figma frame for this
 * page yet, so the layout borrows the site's type and pieces:
 *
 *   intro        cream · "[ About ]" label over the heading, then a lead
 *                statement beside the body (the project synopsis's 32/120% type
 *                and the homepage statement's 20/150% body)
 *   founder      white · the square portrait in a third of the width (sticky from
 *                `lg`, and never taller than the screen above the floating nav)
 *                beside "In short" and "In depth", then "Training & career" in a light
 *                version of the project hero's facts panel (cream, night type)
 *   recognition  night · awards by year beside the release poster (sticky from `lg`)
 *   press        night · three outbound links, label over headline, ↗ arrow
 *   road         the motorcycle photo full width at its own 3:2, the heading over
 *                its sky from `lg` (night type: 6.8:1 on that blue, white would be
 *                2.9:1), and below it the closing line and three links on cream,
 *                set to the two edges like the footer's row, which follows on the
 *                same cream
 *
 * Every heading is the homepage's, the `heading` type size (48/120% · -0.03em), with the serif
 * run at 1.08em. Labels are "[ … ]" as on the project page and the live site.
 * Mentions of The Scroll That Stole Time link to its case study.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { awards, career, press } from "../data/about";

// Sizes come from the site's type scale (`global.css`).
const label = "text-label font-medium uppercase opacity-50";
const statement = "text-lead";
const body = "text-body-lg tracking-[-0.02em]";
const heading = "text-heading font-normal";
const serif = "font-serif text-[1.08em] leading-none";
const inlineLink = "underline decoration-1 underline-offset-4 transition-opacity hover:opacity-70";
const scrollHref = "/projects/the-scroll-that-stole-time";

const nextLinks = [
  { href: "/#work", label: "Watch the films" },
  { href: "/#services", label: "What the studio does" },
  { href: "#contact", label: "Get in touch" },
];
---

<SiteLayout
  title="About"
  description="Flying Turtle Studio is an independent film and video production studio in Guwahati, Assam, founded by filmmaker Kaushik Sharma in April 2022."
>
  <section
    class="bg-cream px-4 pb-20 pt-32 text-night sm:px-8 sm:pb-24 sm:pt-40 lg:px-16 lg:pb-[120px] lg:pt-[184px]"
    aria-labelledby="about-heading"
  >
    <p class={label}>[ About ]</p>
    <h1 id="about-heading" class:list={["mt-3", heading]}>
      A turtle<br />
      <span class={serif}>that flies</span>
    </h1>

    <div class="mt-12 grid gap-8 sm:mt-16 lg:mt-24 lg:grid-cols-2 lg:gap-16">
      <p class={statement}>
        Flying Turtle Studio is an independent film and video production studio based in Guwahati, Assam, founded by
        Kaushik Sharma in April 2022.
      </p>
      <div class:list={["space-y-6", body]}>
        <p>
          The name comes from an unlikely image, a turtle that flies, and that’s the whole philosophy: stay grounded,
          steady, and patient like a turtle, but let the creative ambition soar without limits.
        </p>
        <p>
          The studio works across documentary, essay films, branded and corporate content, drone cinematography, and
          short narrative work, with Kaushik personally handling most of the process end to end, writing, directing,
          shooting, and editing, rather than outsourcing the vision to a large crew.
        </p>
        <p>
          This hands-on, do-it-yourself approach was put to the test with the studio’s debut short film,
          <a class={inlineLink} href={scrollHref}>The Scroll That Stole Time</a>, made on a zero budget with a skeleton
          cast and no formal crew, which went on to win Best Essay Film at FICIMAD 2026 in Madrid. Proof that
          resourcefulness and a real point of view can travel further than a big budget.
        </p>
        <p class="pt-4 font-serif text-lead tracking-normal">
          Grounded in Story. Free in Imagination.
        </p>
      </div>
    </div>
  </section>

  <section
    class="bg-white px-4 py-16 text-night sm:px-8 sm:py-24 lg:px-16 lg:py-[120px]"
    aria-labelledby="founder-heading"
  >
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
      <!-- The whole square photo, 1034px (the largest the live site has). From `lg`
           it fits between its 64px sticky offset and the floating nav's 112px band. -->
      <img
        class="aspect-square w-full bg-cream object-cover max-lg:max-w-[420px] lg:sticky lg:top-16 lg:max-w-[calc(100svh-11rem)] lg:self-start"
        src="/about/kaushik-sharma.jpg"
        alt="Portrait of filmmaker Kaushik Sharma in a tan jacket, seated against a plain white wall, looking towards the camera."
        width="1034"
        height="1034"
        loading="lazy"
        decoding="async"
      />

      <!-- From `lg` the three blocks spread over the row's height (space-between), so
           the heading sits level with the portrait's top and the last line with its
           bottom; the gaps never close below 64px. Where the text runs longer than
           the portrait, the gaps stay at 64px and the portrait is the one pinned. -->
      <div class="flex flex-col gap-12 lg:justify-between lg:gap-16">
        <h2 id="founder-heading" class={heading}>
          Kaushik<br />
          <span class={serif}>Sharma</span>
        </h2>

        <div>
          <p class={label}>[ In short ]</p>
          <p class:list={["mt-4 sm:mt-5", statement]}>
            Kaushik Sharma is a Guwahati-based filmmaker who believes small stories, told honestly, travel the farthest. He
            founded Flying Turtle Studio in 2022 to make documentaries and essay films his own way, with a camera, an idea
            and whatever he can carry. His debut short won Best Essay Film at FICIMAD 2026 in Madrid.
          </p>
        </div>

        <div>
          <p class={label}>[ In depth ]</p>
          <p class:list={["mt-4 sm:mt-5", body]}>
            Kaushik Sharma grew up wanting to tell stories that actually mean something, and spent over a decade chasing
            that across two countries before he trusted himself enough to do it his own way. He trained at Whistling Woods
            International in Mumbai, studied Media Arts at Wintec in New Zealand, and along the way edited for Doordarshan,
            Mukta Arts and Māori Television, picking up a feel for pace, light and people wherever he worked. In 2022 he
            came home to Guwahati and started Flying Turtle Studio, built on a simple belief: stay grounded like a turtle,
            but let the ideas fly. He writes, shoots, directs, edits and colour grades most of his own work, because he
            would rather do one thing fully than five things halfway. That instinct paid off with
            <a class={inlineLink} href={scrollHref}>The Scroll That Stole Time</a>, a zero-budget debut short that went
            on to win Best Essay Film at FICIMAD 2026 in Madrid. Outside of work, he is usually somewhere in Northeast
            India on a motorcycle, looking for the next story.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16 lg:mt-[120px]">
      <h3 class="text-body-lg">Training &amp; career</h3>
      <dl
        class="mt-4 grid gap-6 border border-night/10 bg-cream p-5 text-night sm:grid-cols-3 sm:gap-x-8 sm:p-8 lg:gap-x-16"
      >
        {
          career.map(({ label: name, lines, note }) => (
            <div class="flex flex-col items-start gap-2.5">
              <dt class={label}>[ {name} ]</dt>
              <dd class="text-body-lg">
                {lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {note && <span class="mt-2 block text-body opacity-70">{note}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section
    class="bg-night px-4 py-16 text-cream sm:px-8 sm:py-24 lg:px-16 lg:py-[120px]"
    aria-labelledby="awards-heading"
    data-nav-tone="light"
  >
    <p class={label}>[ Recognition ]</p>
    <h2 id="awards-heading" class:list={["mt-3", heading]}>
      Awards &amp; <span class={serif}>Recognition</span>
    </h2>

    <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-2 lg:gap-16">
      <img
        class="aspect-video w-full border border-white/10 bg-black object-cover lg:sticky lg:top-16 lg:order-2 lg:self-start"
        src="/about/scroll-award-poster.jpg"
        alt="Award poster for The Scroll That Stole Time showing the FICIMAD 2026 Best Essay Film laurel and the FICSAMAS official selection laurel."
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />

      <ol class="border-b border-white/10">
        {
          awards.map(({ year, title, from, forScroll, note }) => (
            <li class="grid gap-3 border-t border-white/10 py-8 sm:grid-cols-[88px_minmax(0,1fr)] sm:gap-6">
              <p class:list={["sm:pt-[7px]", label]}>{year}</p>
              <div>
                <h3 class="text-title">{title}</h3>
                <p class="mt-2 text-body opacity-70">
                  {from}
                  {forScroll && (
                    <>
                      {" "}
                      For <a class={inlineLink} href={scrollHref}>The Scroll That Stole Time</a>.
                    </>
                  )}
                </p>
                {note && <p class="mt-4 text-body opacity-70">{note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="bg-night px-4 pb-16 text-cream sm:px-8 sm:pb-24 lg:px-16 lg:pb-[120px]"
    aria-labelledby="press-heading"
    data-nav-tone="light"
  >
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class={label}>[ Press ]</p>
        <h2 id="press-heading" class:list={["mt-3", heading]}>
          In the <span class={serif}>news</span>
        </h2>
      </div>

      <ul class="border-b border-white/10">
        {
          press.map(({ outlet, headline, href }) => (
            <li class="border-t border-white/10">
              <a class="group flex items-start justify-between gap-6 py-6 sm:py-8" href={href} target="_blank" rel="noopener noreferrer">
                <span class="flex flex-col gap-3">
                  <span class={label}>{outlet}</span>
                  <span class="text-title transition-opacity group-hover:opacity-70">
                    {headline}
                  </span>
                </span>
                <svg
                  class="mt-5 size-8 shrink-0 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none sm:mt-6"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M6 6v2h8.59L5 17.59 6.41 19 16 9.41V18h2V6z" />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-cream text-night" aria-labelledby="road-heading">
    <div class="relative">
      <img
        class="aspect-[3/2] w-full bg-[#5fa6d8] object-cover"
        src="/about/on-the-road.jpg"
        alt="Kaushik Sharma’s orange and white KTM 390 Adventure parked on a dirt track beside a bamboo fence and banana plants under a clear blue Assam sky."
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
        data-nav-tone="light"
      />
      <!-- From `lg` the heading sits in the open sky at the photo's top left, inside
           the page's 64px margins; the sky runs a quarter of the way down there. -->
      <h2
        id="road-heading"
        class:list={["px-4 pt-12 sm:px-8 sm:pt-16 lg:absolute lg:left-16 lg:top-16 lg:p-0", heading]}
      >
        Somewhere<br />
        <span class={serif}>on the road</span>
      </h2>
    </div>

    <!-- Laid out like the footer's row under it: the line on the left at the
         footer's measure, the links pushed to the right edge. -->
    <div
      class="flex flex-col gap-10 px-4 pb-24 pt-6 sm:px-8 sm:pt-8 lg:flex-row lg:items-start lg:justify-between lg:gap-16 lg:px-16 lg:pb-[120px] lg:pt-16"
    >
      <p class:list={["lg:max-w-[21.85em]", statement]}>
        Outside of work, he is usually somewhere in Northeast India on a motorcycle, looking for the next story.
      </p>

      <ul class="flex shrink-0 flex-col items-start gap-4">
        {
          nextLinks.map(({ href, label: text }) => (
            <li>
              <a class:list={["group inline-flex items-start", statement]} href={href}>
                <span class="underline underline-offset-[0.19em] [text-decoration-thickness:0.07em]">{text}</span>
                <svg
                  class="size-[1.2em] shrink-0 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M6 6v2h8.59L5 17.59 6.41 19 16 9.41V18h2V6z" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>
